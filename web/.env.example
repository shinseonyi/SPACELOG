# 개발 중 /api 요청을 넘길 로컬 서버 주소 (예: http://127.0.0.1:47800). 비워 두면 넘기지 않는다.
API_TARGET=

# 챗봇 버튼이 여는 주소 (http/https). 비워 두면 버튼은 보이지만 "준비 중"이라고 알린다. 빌드할 때 들어가므로 바꾸면 다시 빌드한다
VITE_CHATBOT_URL=

# 받는 곳(Render 의 site/) 공개 주소. 상단 바 로고가 여는 사용 방법(How to use) 페이지가 그 아래 /how-to-use/ 에 있다.
# 비워 두면 로컬 서버가 내려주는 사본(같은 주소의 /how-to-use/)을 연다
VITE_SITE_URL=
